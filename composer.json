{
    "name": "flatrate/flarum-forum-navigation",
    "description": "FlatRate.wiki presentation navigation: Push to Start, Technician Topics, and Brands tree.",
    "type": "flarum-extension",
    "license": "MIT",
    "keywords": [
        "flarum",
        "navigation",
        "sidebar",
        "community",
        "brands"
    ],
    "homepage": "https://flatrate.wiki",
    "support": {
        "issues": "https://github.com/mrkcntrmn/flatrate-flarum-forum-navigation/issues",
        "source": "https://github.com/mrkcntrmn/flatrate-flarum-forum-navigation"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.2",
        "flarum/tags": "^2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "FlatRate\\ForumNavigation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatRate\\ForumNavigation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "flarum-extension": {
            "title": "FlatRate Forum Navigation",
            "category": "feature",
            "icon": {
                "name": "fas fa-sitemap",
                "backgroundColor": "#111827",
                "color": "#ffffff"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev",
            "dev-feat/f2-minimal-nav-seo": "2.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
